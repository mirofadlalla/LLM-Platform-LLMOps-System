# Copy to .env and fill in your values.
# VITE_ prefix is required — Vite only exposes these to the browser bundle.

# URL of the running FastAPI backend.
#
# PRODUCTION (Vercel):
#   Use a relative path so Vercel's server-side rewrite proxy handles the
#   request (see vercel.json). The browser only ever talks to Vercel over
#   HTTPS — no Mixed Content errors.
#   Value: /api/v1
#
# LOCAL DEV (Vite dev server):
#   The Vite proxy in vite.config.js forwards /api/* → http://localhost:8000,
#   so the same relative path works here too.
#   Value: /api/v1
#
# DIRECT (bypass proxy — not recommended in production, causes Mixed Content):
#   Value: http://63.187.109.126:8000/api/v1
VITE_API_URL=/api/v1

# ==============================================================================
# LLMOps Platform - Environment Configuration Template
# Copy this file to .env and fill in your values for production deployment:
#   cp .env.example .env
# ==============================================================================

# ── EC2 Host Configuration ───────────────────────────────────────────────────
# Port exposed on the EC2 host for the FastAPI application
PORT=8000

# Docker image source: local build by default, or pull from GitHub Container Registry (GHCR)
# BACKEND_IMAGE=ghcr.io/mirofadlalla/llmops-backend:latest

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# In Docker Compose, inter-container communication uses service name 'postgres'
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=llmops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis Cache & Broker ──────────────────────────────────────────────────────
# In Docker Compose, inter-container communication uses service name 'redis'
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_BROKER_DB=0
REDIS_BACKEND_DB=1
REDIS_CONNECT_TIMEOUT=2

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Maximum requests per API key within the specified sliding window (in seconds)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# ── Authentication & Security ─────────────────────────────────────────────────
# JWT Secret Key for signing user authentication tokens
JWT_SECRET_KEY=replace_with_secure_random_hex_or_string_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Platform master secret / internal secret key
API_SECRET_KEY=replace_with_platform_secret_key

# ── External LLM Providers & Integrations ────────────────────────────────────
# Groq API key for Groq-hosted models (e.g. gpt-oss-20b, qwen3-27b)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Hugging Face API key for Hugging Face Inference API (e.g. qwen-2.5-1.5b)
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here

# Weights & Biases (optional for tracking)
WANDB_API_KEY=

# ── Default LLM Provider & Model ──────────────────────────────────────────────
# Provider must be one of: groq | huggingface
# Model must be a registered slug in app/llm/registry.py
# Groq slugs: gpt-oss-20b | gpt-oss-120b | qwen3-27b
# HuggingFace slugs: qwen-2.5-1.5b
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=gpt-oss-20b

# ── LLM Generation Defaults ───────────────────────────────────────────────────
LLM_MAX_NEW_TOKENS=150
LLM_DEFAULT_TEMPERATURE=0.2
LLM_COST_PER_TOKEN=0.00001

# ── Celery Task Retry Policy ──────────────────────────────────────────────────
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_COUNTDOWN=5

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=app.log
LOG_LEVEL=INFO

# ── CORS Settings ─────────────────────────────────────────────────────────────
# JSON-formatted list of allowed frontend origins
# In production, restrict to your frontend domain: e.g. ["https://app.yourdomain.com"]
CORS_ORIGINS=["*"]

# ── Application Metadata ──────────────────────────────────────────────────────
APP_TITLE=LLMOps Platform
APP_VERSION=0.1.0
